generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  role      Role
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  professor Professor?
  student   Student?

  @@map("users")
}

model Course {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  acronym         String           @unique
  coursePeriod    CoursePeriod     @map("course_period")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  students        Student[]
  subjects        Subject[]
  userInvitations UserInvitation[]

  @@map("courses")
}

model Degree {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  active     Boolean     @default(true)
  professors Professor[]

  @@map("degrees")
}

model Field {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  active     Boolean     @default(true)
  professors Professor[]

  @@map("fields")
}

model Student {
  id         Int      @id @default(autoincrement())
  enrollment String   @unique
  phone      String
  address    String
  city       String
  neighborhood String
  state      String
  courseId   Int      @map("course_id")
  createdAt  DateTime @default(now()) @map("created_at")
  number     String
  updatedAt  DateTime @updatedAt @map("updated_at")
  userId     Int      @unique @map("user_id")
  zipCode    String   @map("zip_code")
  grades     Grade[]
  course     Course   @relation(fields: [courseId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model Professor {
  id                 Int       @id @default(autoincrement())
  createdAt          DateTime  @default(now()) @map("created_at")
  degreeId           Int       @map("degree_id")
  fieldId            Int       @map("field_id")
  teachingExperience Int       @map("teaching_experience") //Month of teaching experience
  updatedAt          DateTime  @updatedAt @map("updated_at")
  userId             Int       @unique @map("user_id")
  degree             Degree    @relation(fields: [degreeId], references: [id])
  field              Field     @relation(fields: [fieldId], references: [id])
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects           Subject[]

  @@map("professors")
}

model Subject {
  id          Int       @id @default(autoincrement())
  name        String
  workload    Int
  semester    Int
  courseId    Int       @map("course_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  professorId Int       @map("professor_id")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  grades      Grade[]
  course      Course    @relation(fields: [courseId], references: [id])
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@map("subjects")
}

model Grade {
  id        Int       @id @default(autoincrement())
  grade1    Float
  grade2    Float?
  average   Float?
  situation Situation @default(PENDING)
  createdAt DateTime  @default(now()) @map("created_at")
  studentId Int       @map("student_id")
  subjectId Int       @map("subject_id")
  updatedAt DateTime  @updatedAt @map("updated_at")
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@map("grades")
}

model UserInvitation {
  id         Int       @id @default(autoincrement())
  enrollment String    @unique
  email      String    @unique
  role       Role
  courseId   Int?      @map("course_id")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  course     Course?   @relation(fields: [courseId], references: [id])

  @@map("user_invitations")
}

enum Role {
  ADMIN
  PROFESSOR
  STUDENT
}

enum Situation {
  PASSED
  FAILED
  PENDING
}

enum CoursePeriod {
  MORNING
  AFTERNOON
  EVENING
  FULL_TIME
}
